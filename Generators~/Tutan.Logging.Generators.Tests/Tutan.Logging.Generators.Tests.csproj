<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the generator over declarations compiled in memory: what it refuses, and what it writes
       for what it accepts. The package's attributes and enums are compiled in from their own files,
       since the generator reads them by name. Whether what it writes compiles against the package
       is proven in Unity, by the package's own tests of generated events. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tutan.Logging.Generators\Tutan.Logging.Generators.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\Runtime\Attributes.cs" Link="Package\Attributes.cs" LogicalName="Attributes.cs" />
    <EmbeddedResource Include="..\..\Runtime\Kinds.cs" Link="Package\Kinds.cs" LogicalName="Kinds.cs" />
    <EmbeddedResource Include="..\..\Runtime\LogLevel.cs" Link="Package\LogLevel.cs" LogicalName="LogLevel.cs" />
    <EmbeddedResource Include="..\..\Tests\Editor\TestEvents.cs" Link="Package\TestEvents.cs" LogicalName="TestEvents.cs" />
  </ItemGroup>

</Project>
