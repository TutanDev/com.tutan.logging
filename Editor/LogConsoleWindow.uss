/* The log console. Light theme by default; .dark is set on the root under the dark skin. */

.log-console {
    --secondary: #5C5C5C;
    --link: #1D6FB8;
    --trace: #7A7A7A;
    --debug: #5E6B7A;
    --information: #1D6FB8;
    --warning: #8F6300;
    --error: #C42B2B;
    --critical: #FFFFFF;
    --critical-back: #B3261E;
    --mark: #1D6FB8;
    --source-back: rgba(0, 0, 0, 0.06);
    --current-line: rgba(229, 181, 59, 0.28);
    --saved-on: rgba(29, 111, 184, 0.18);
    --frame-hover: rgba(0, 0, 0, 0.06);
}

.log-console.dark {
    --secondary: #9A9A9A;
    --link: #6CB4EE;
    --trace: #7F7F7F;
    --debug: #9AA4B1;
    --information: #6CB4EE;
    --warning: #E5B53B;
    --error: #F26D6D;
    --critical: #FFFFFF;
    --critical-back: #B3261E;
    --mark: #4FA3E0;
    --source-back: rgba(0, 0, 0, 0.22);
    --current-line: rgba(229, 181, 59, 0.18);
    --saved-on: rgba(79, 163, 224, 0.25);
    --frame-hover: rgba(255, 255, 255, 0.06);
}

/* Toolbar */

.session {
    min-width: 160px;
    -unity-text-align: middle-left;
}

.badge {
    min-width: 44px;
    opacity: 0.5;
}

.badge.on {
    opacity: 1;
}

.badge.zero {
    color: var(--secondary);
}

.badge.level-warning {
    color: var(--warning);
}

.badge.level-error,
.badge.level-critical {
    color: var(--error);
}

.status {
    -unity-text-align: middle-right;
    padding: 0 6px;
    color: var(--secondary);
}

/* The Clear button's menu sits against it, an arrow alone. */
.clear {
    border-right-width: 0;
}

.clear-menu {
    min-width: 16px;
    padding: 0 2px;
}

/* Saved filters, a row of buttons under the toolbar */

.saved {
    flex-direction: row;
    align-items: center;
    padding: 0 6px;
}

.saved > .swatch {
    width: 8px;
    height: 8px;
    margin-right: 4px;
    border-radius: 4px;
    flex-shrink: 0;
}

.saved > Label {
    margin: 0;
    padding: 0;
}

.saved.on {
    background-color: var(--saved-on);
}

.saved.on > Label {
    -unity-font-style: bold;
}

.saved-add {
    min-width: 22px;
    -unity-text-align: middle-center;
    color: var(--secondary);
}

/* The query line, and what is said under it */

.query {
    margin: 3px 4px 2px 4px;
}

.said-line {
    flex-direction: row;
    align-items: center;
    padding: 1px 6px;
}

.said-line > Label {
    flex-shrink: 1;
    white-space: normal;
}

.said-line.error > Label {
    color: var(--error);
}

.said-line.warning > Label {
    color: var(--warning);
}

.said-line.info > Label {
    color: var(--secondary);
}

.retry {
    margin-left: 6px;
}

.panes {
    flex-grow: 1;
}

/* Rows: a cell each column, given its row's classes, so no rule leans on how the list nests them. */

.rows .cell {
    flex-grow: 1;
    margin: 0;
    padding: 0 3px;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.rows .cell.time,
.rows .cell.event,
.rows .cell.call-site {
    color: var(--secondary);
}

.rows .cell.frame,
.rows .cell.duration,
.rows .cell.thread {
    -unity-text-align: middle-right;
    color: var(--secondary);
}

.rows .cell.level {
    -unity-font-style: bold;
}

.rows .cell.category {
    -unity-font-style: bold;
}

.rows .cell.message {
    flex-direction: row;
    align-items: center;
    padding: 0;
}

.rows .cell.message > Label {
    margin: 0;
    padding: 0 3px;
    -unity-text-align: middle-left;
    white-space: nowrap;
}

.rows .cell.message > .lost {
    width: 16px;
    flex-shrink: 0;
    padding: 0;
    -unity-text-align: middle-center;
    color: var(--warning);
}

.rows .cell.message > .indent {
    flex-shrink: 0;
}

.rows .cell.message > .fold {
    width: 16px;
    flex-shrink: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

.rows .cell.message > .line {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

.rows .cell.message > .repeats,
.rows .cell.message > .suppressed {
    flex-shrink: 0;
    color: var(--secondary);
}

.rows .cell.level.level-trace,
.rows .cell.message.level-trace > .line {
    color: var(--trace);
}

.rows .cell.level.level-debug {
    color: var(--debug);
}

.rows .cell.level.level-information {
    color: var(--information);
}

.rows .cell.level.level-warning,
.rows .cell.message.level-warning > .line {
    color: var(--warning);
}

.rows .cell.level.level-error,
.rows .cell.message.level-error > .line {
    color: var(--error);
}

.rows .cell.level.level-critical {
    color: var(--critical);
    background-color: var(--critical-back);
    border-radius: 2px;
}

.rows .cell.message.level-critical > .line {
    color: var(--error);
    -unity-font-style: bold;
}

.rows .cell.message.scope > .line {
    -unity-font-style: italic;
}

.rows .cell.context {
    opacity: 0.7;
}

.rows .cell.message.gone > .line {
    color: var(--secondary);
    -unity-font-style: italic;
}

/* Categories */

.category-item {
    flex-direction: row;
    align-items: center;
    height: 18px;
    padding: 0 6px 0 4px;
}

.category-item > .mark {
    width: 10px;
    height: 10px;
    margin-right: 5px;
    flex-shrink: 0;
    border-width: 1px;
    border-radius: 2px;
    border-color: var(--secondary);
}

.category-item > .mark.all {
    background-color: var(--mark);
    border-color: var(--mark);
}

.category-item > .mark.some {
    background-color: rgba(79, 163, 224, 0.4);
    border-color: var(--mark);
}

.category-item > .name {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding: 0;
}

.category-item > .count {
    color: var(--secondary);
    padding: 0;
    margin-left: 4px;
}

.category-item.hidden > .name {
    opacity: 0.45;
}

/* Details */

.details > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    padding: 6px 8px;
}

.details Label {
    white-space: normal;
}

.details .header {
    flex-direction: row;
    align-items: center;
}

.details .header > .level {
    -unity-font-style: bold;
    margin-right: 6px;
}

.details .header > .level.level-warning {
    color: var(--warning);
}

.details .header > .level.level-error,
.details .header > .level.level-critical {
    color: var(--error);
}

.details .header > .level.level-information {
    color: var(--information);
}

.details .key {
    -unity-font-style: bold;
    font-size: 13px;
}

.details .meta,
.details .note,
.details .hint {
    color: var(--secondary);
}

.details .hint {
    margin-top: 8px;
}

.details .message {
    margin: 6px 0 2px 0;
    font-size: 12px;
}

.details .section {
    -unity-font-style: bold;
    color: var(--secondary);
    margin-top: 10px;
    margin-bottom: 2px;
}

.details .field {
    flex-direction: row;
    align-items: flex-start;
}

.details .field-name {
    width: 140px;
    flex-shrink: 0;
    color: var(--secondary);
}

.details .field-value {
    flex-shrink: 1;
}

.details .tag {
    margin-left: 6px;
    padding: 0 4px;
    border-radius: 3px;
    border-width: 1px;
    border-color: var(--secondary);
    color: var(--secondary);
}

.details .link {
    color: var(--link);
    cursor: link;
}

.details .link:hover {
    opacity: 0.75;
}

/* A stack's frames: the method, then its file and line; a press shows the source under it. */

.details .frame-line {
    flex-direction: row;
    align-items: flex-start;
    padding: 1px 0;
    border-radius: 3px;
}

.details .stack-frame.placed > .frame-line:hover {
    background-color: var(--frame-hover);
}

/* Only the sides are reset, so the glyph keeps a label's padding above it and sits on the method's first line. */
.details .frame-line > .fold {
    width: 14px;
    flex-shrink: 0;
    margin-left: 0;
    margin-right: 0;
    padding-left: 0;
    padding-right: 0;
    -unity-text-align: upper-center;
    color: var(--secondary);
}

/* A name with no space to wrap at is cut at the file and line, not drawn under them. */
.details .frame-line > .method {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.details .frame-line > .place {
    flex-shrink: 0;
    margin-left: 12px;
    margin-right: 2px;
}

.details .stack-frame.outside > .frame-line > .method,
.details .stack-frame.unplaced > .frame-line > .method,
.details .stack-frame.unplaced > .frame-line > .place {
    color: var(--secondary);
}

.details .stack-frame > .source,
.details .stack-frame > .frame-hint {
    margin-left: 14px;
}

.details .stack-frame > .frame-hint {
    margin-top: 2px;
    margin-bottom: 4px;
}

.details .source {
    margin: 4px 0;
    padding: 4px 0;
    background-color: var(--source-back);
    border-radius: 3px;
    cursor: link;
}

.details .source-line {
    flex-direction: row;
}

.details .source-line.current {
    background-color: var(--current-line);
}

.details .source-line > .number {
    width: 44px;
    flex-shrink: 0;
    margin-right: 8px;
    -unity-text-align: upper-right;
    color: var(--secondary);
}

.details .source-line > .code {
    white-space: nowrap;
}

/* The dialogs that save a filter and choose a category's colour */

.log-console-dialog {
    padding: 8px 10px;
}

.dialog-refused {
    min-height: 16px;
    margin: 4px 3px 0 3px;
    white-space: normal;
    color: var(--error);
}

.dialog-buttons {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 6px;
}

.dialog-buttons > Button {
    min-width: 72px;
}

/* Project Settings > Log Console */

.log-console-settings {
    padding: 1px 10px 10px 10px;
}

.log-console-settings > .settings-title {
    font-size: 19px;
    -unity-font-style: bold;
    margin: 2px 0 6px 0;
}

.log-console-settings > .settings-header {
    -unity-font-style: bold;
    margin-top: 14px;
    margin-bottom: 2px;
}

.log-console-settings > .settings-note {
    white-space: normal;
    color: var(--secondary);
    margin-bottom: 4px;
}

.log-console-settings > HelpBox {
    margin: 4px 0;
}

.settings-row {
    flex-direction: row;
    align-items: center;
    min-height: 22px;
}

.settings-row > .swatch {
    width: 12px;
    height: 12px;
    margin: 0 6px 0 2px;
    border-radius: 2px;
    flex-shrink: 0;
}

.settings-row > .settings-name {
    width: 160px;
    flex-shrink: 0;
    -unity-font-style: bold;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.settings-row > .settings-query {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--secondary);
}

.settings-row > .settings-button {
    flex-shrink: 0;
}

.log-console-settings > .settings-add {
    align-self: flex-start;
    margin-top: 4px;
}

.log-console-settings > .settings-left-out {
    margin: 0;
}
